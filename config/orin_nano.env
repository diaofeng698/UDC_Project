# Jetson Orin Nano deployment defaults.
# Override any value in the shell, for example: PRECISION=fp16 make engine
# Supported precisions: fp32, fp16, int8, int8-fp16 (INT8 with FP16 fallback).
: "${MODEL_PATH:=bnudc_v1_trt_static.onnx}"
: "${ENGINE_DIR:=engines}"
: "${RESULTS_DIR:=results}"
: "${PRECISION:=fp32}"
: "${WORKSPACE_MIB:=2048}"
: "${BUILD_OPT_LEVEL:=5}"
: "${WARMUP_MS:=1000}"
: "${BENCHMARK_SECONDS:=30}"
: "${INFERENCE_STREAMS:=1}"
: "${USE_CUDA_GRAPH:=1}"
: "${ENABLE_LAYER_PROFILE:=1}"

# Expected production target. These values are checked strictly only on Jetson.
: "${TARGET_BOARD:=Jetson Orin Nano Super 8GB}"
: "${TARGET_SOC:=tegra234}"
: "${TARGET_TENSORRT:=10.3.0.30}"
: "${TARGET_PYTHON:=3.10}"
: "${TARGET_CPU:=Cortex-A78AE}"
: "${TARGET_CPU_CORES:=6}"
